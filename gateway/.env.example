# Gateway HTTP Port
GATEWAY_PORT="4000"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# QoreChain EVM RPC (Diana Testnet Chain ID 9800 or local Anvil fork)
QORECHAIN_RPC_URL="http://127.0.0.1:8545"
QORECHAIN_CHAIN_ID="9800"
# QoreChain REST (LCD) used to read EVM authorisation windows. Default: Diana when the RPC is not
# localhost; empty on a local Anvil (no windows there).
QORECHAIN_REST_URL="https://api-testnet.qore.host"
SYNAPSE_VAULT_ADDRESS="<DEPLOYED_SYNAPSE_VAULT_ADDRESS>"

# Server-only Pinata JWT (NEVER exposed to the browser SPA)
PINATA_JWT=""
