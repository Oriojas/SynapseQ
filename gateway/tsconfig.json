{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@sdk/*": ["../sdk/src/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
