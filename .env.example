# =============================================================================
# SynapseQ — Archivo Único de Variables de Entorno (.env.example)
# Copia este archivo a .env en la raíz del proyecto: cp .env.example .env
# =============================================================================

# Red QoreChain Diana Testnet (Chain ID 9800)
QORECHAIN_RPC_URL="<TU_RPC_URL_DIANA_TESTNET>"
QORECHAIN_CHAIN_ID="9800"
LOCAL_RPC_URL="http://127.0.0.1:8545"

# Puertos locales para 'make init'
ANVIL_PORT="8545"
FRONTEND_PORT="5173"

# Despliegue de Contratos en Foundry (NUNCA subir claves reales al repositorio)
DEPLOYER_PRIVATE_KEY="<TU_CLAVE_PRIVADA_DE_DESPLIEGUE>"
SYNAPSE_VAULT_ADDRESS="<DIRECCION_DEL_CONTRATO_DESPLEGADO>"

# Almacenamiento Cifrado Pinata IPFS (Opcional — si queda vacío usa el fallback en memoria/local)
PINATA_JWT="<TU_PINATA_JWT_TOKEN>"
IPFS_GATEWAY_URL="<URL_GATEWAY_IPFS>"

# Variables expuestas al Frontend (Vite)
VITE_QORECHAIN_RPC_URL="<TU_RPC_URL_DIANA_TESTNET>"
VITE_QORECHAIN_CHAIN_ID="9800"
VITE_SYNAPSE_VAULT_ADDRESS="<DIRECCION_DEL_CONTRATO_DESPLEGADO>"
VITE_PINATA_JWT="<TU_PINATA_JWT_TOKEN>"
VITE_IPFS_GATEWAY_URL="<URL_GATEWAY_IPFS>"
