# QoreChain Diana Testnet Configuration
VITE_QORECHAIN_RPC_URL=<TU_RPC_URL_DIANA_TESTNET>
VITE_QORECHAIN_CHAIN_ID=9800
VITE_SYNAPSE_VAULT_ADDRESS=<DIRECCION_DEL_CONTRATO_DESPLEGADO>

# Key-Release & Pinata Proxy Gateway (REQUIRED for on-chain mode: envelopes and CIDs never go on-chain)
VITE_GATEWAY_URL=http://127.0.0.1:4000

# Public IPFS gateway used to download ciphertext pinned on Pinata (read-only, no secrets)
VITE_IPFS_GATEWAY_URL=<URL_GATEWAY_IPFS>

# NOTE: never put PINATA_JWT in a VITE_* variable: Vite inlines it into the public bundle.
# The JWT lives only in gateway/.env (PINATA_JWT).
