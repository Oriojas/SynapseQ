# QoreChain EVM RPC (use http://127.0.0.1:8545 for local Anvil fork or https://evm-testnet.qore.host for Diana Testnet)
QORECHAIN_RPC_URL="https://evm-testnet.qore.host"

# Deployed SynapseVaultRegistry contract address
SYNAPSE_VAULT_ADDRESS="<DEPLOYED_SYNAPSE_VAULT_ADDRESS>"

# Pinata IPFS (optional — leave empty to use local/memory fallback during development)
# Get a JWT at: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=""
IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"
